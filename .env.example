PORT=3000

# PostgreSQL Reg.Cloud. URL-encode special characters in the password.
DATABASE_URL=postgresql://user1:YOUR_PASSWORD@79.174.89.250:15529/db1
# Download the CA certificate from the cluster's Connections tab.
# Relative paths are resolved from the project root.
PGSSLROOTCERT=certs/reg-cloud-ca.crt
PGSSLMODE=verify-full

ADMIN_TOKEN=replace-with-a-long-random-token
IP_HASH_SALT=replace-with-a-long-random-salt
KAMAZ_RSS_URL=http://www.kamaz.ru/press/releases/rss/
RSS_REFRESH_MINUTES=30
