{
  "name": "kamaz-dealer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node scripts/php.mjs -S localhost:3000 -t public backend/router.php",
    "start": "node scripts/php.mjs -S localhost:3000 -t dist backend/router.php",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node scripts/php.mjs backend/console.php db:migrate",
    "db:check": "node scripts/php.mjs backend/console.php db:check",
    "news:refresh": "node scripts/php.mjs backend/console.php news:refresh",
    "test:backend": "node scripts/php.mjs backend/tests.php"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
